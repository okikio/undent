{
  "name": "@okikio/undent",
  "version": "0.2.1",
  "exports": "./mod.ts",
  "tasks": {
    "test": "deno test --trace-leaks --v8-flags=--expose-gc",
    "bench": "deno bench --allow-env=NODE_DISABLE_COLORS --v8-flags=--expose-gc",
    "forge": "deno run -A jsr:@roka/forge",
    "build:npm": "deno run -A scripts/build_npm.ts"
  },
  "fmt": {
    "proseWrap": "preserve"
  },
  "publish": {
    "include": [
      "mod.ts",
      "changelog.md",
      "license",
      "readme.md"
    ],
    "exclude": [
      "npm/",
      "scripts/"
    ]
  },
  "license": "MIT"
}
