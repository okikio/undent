{
  "name": "@okikio/undent",
  "version": "0.3.3",
  "exports": {
    ".": "./mod.ts",
    "./unicode": "./unicode.ts"
  },
  "imports": {
    "@deno/dnt": "jsr:@deno/dnt@^0.44.0",
    "@optique/core": "jsr:@optique/core@^1.4.0",
    "@std/expect": "jsr:@std/expect@^1.0.20",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@std/semver": "jsr:@std/semver@^1.0.8",
    "@std/testing": "jsr:@std/testing@^1.0.21",
    "dedent": "npm:dedent@^1.7.2",
    "fast-check": "npm:fast-check@^4.11.0",
    "mitata": "npm:mitata@^1.0.34",
    "oxc-parser": "npm:oxc-parser@^0.159.0",
    "outdent": "npm:outdent@^0.8.0"
  },
  "tasks": {
    "lint": "deno lint",
    "doc": "deno doc --lint mod.ts unicode.ts _unicode_constants.ts",
    "deps:ci": "deno ci",
    "test": "deno test --trace-leaks --v8-flags=--expose-gc",
    "bench": "deno bench --allow-env=NODE_DISABLE_COLORS --v8-flags=--expose-gc",
    "build:npm": "deno run -A scripts/build_npm.ts",
    "release:verify": "deno task deps:ci && deno task lint && deno task doc && deno task test && deno task bench && deno task build:npm",
    "release:dry-run": "deno task deps:ci && deno task build:npm && deno publish --dry-run",
    "unicode:eaw:check": "deno run --allow-net=www.unicode.org --allow-env=NAPI_RS_NATIVE_LIBRARY_PATH,NAPI_RS_ENFORCE_VERSION_CHECK,NAPI_RS_FORCE_WASI --allow-ffi scripts/sync_unicode_east_asian_width.ts",
    "unicode:eaw:update": "deno run --allow-net=www.unicode.org --allow-env=NAPI_RS_NATIVE_LIBRARY_PATH,NAPI_RS_ENFORCE_VERSION_CHECK,NAPI_RS_FORCE_WASI --allow-ffi --allow-read=_unicode_constants.ts --allow-write=_unicode_constants.ts scripts/sync_unicode_east_asian_width.ts --write"
  },
  "fmt": {
    "proseWrap": "preserve"
  },
  "lint": {
    "exclude": [
      "mod_bench.ts",
      "*_test.ts",
      "scripts/",
      "npm/"
    ]
  },
  "publish": {
    "include": [
      "mod.ts",
      "_unicode_constants.ts",
      "unicode.ts",
      "changelog.md",
      "license",
      "readme.md"
    ],
    "exclude": [
      "npm/",
      "scripts/"
    ]
  },
  "license": "MIT"
}
